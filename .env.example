SPRING_PROFILES_ACTIVE=prod
PORT=8080
# Never commit real credentials. Copy this file to .env and fill values locally.
# DB_URL example format only — replace host, port and database.
DB_URL=jdbc:mysql://CHANGE-ME-HOST:3306/CHANGE-ME-DB?useSSL=true&serverTimezone=UTC
DB_USERNAME=CHANGE-ME-USER
DB_PASSWORD=CHANGE-ME-PASSWORD
HIBERNATE_DDL_AUTO=validate
# Minimum 32 chars, generated via: openssl rand -base64 48
# MUST be different from APP_ENCRYPTION_SECRET.
JWT_SECRET=CHANGE-ME-JWT-SECRET-MIN-32-CHARS-GENERATE-NEW
# Minimum 32 chars, generated via: openssl rand -base64 48
# MUST be different from JWT_SECRET. Required in prod.
APP_ENCRYPTION_SECRET=CHANGE-ME-ENCRYPTION-SECRET-MIN-32-CHARS-GENERATE-NEW
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
# Super-admin / platform-admin token (inke paas refresh token nahi). Default 8h.
JWT_ADMIN_ACCESS_TOKEN_EXPIRATION=28800000

# AI chat opt-in (default off: customer data external AI server par nahi jata).
SPRING_AI_OPENAI_CHAT_ENABLED=false
SPRING_AI_OPENAI_BASE_URL=
SPRING_AI_OPENAI_API_KEY=
FRONTEND_URL=https://CHANGE-ME.example.com/
CORS_ALLOWED_ORIGINS=https://CHANGE-ME.example.com/
REMINDER_MOCK_MODE=false
JPA_SHOW_SQL=false
# Company branding images (logo/signature) -> AWS S3 tenant folders.
# AWS switch = Registry.IS_AWS (src/main/java/com/billing/core/Registry.java).
# IS_AWS=false (default) -> files stay on local disk (uploads/). IS_AWS=true -> S3 only.
# (No separate flag: same switch as datasource selection, taaki diverge na ho.)
# Shared bucket for all tenants (isolation via <database_name>/ prefix folders).
AWS_S3_BUCKET=CHANGE-ME-BUCKET
AWS_S3_REGION=ap-south-1
# IAM credentials via standard AWS env vars (never commit real values).
# AWS_ACCESS_KEY_ID=CHANGE-ME
# AWS_SECRET_ACCESS_KEY=CHANGE-ME
# Optional CDN/CloudFront base URL; blank = default https://<bucket>.s3.<region>.amazonaws.com
APP_S3_PUBLIC_BASE_URL=
# Max branding image size in bytes (default 2 MB).
UPLOAD_MAX_BYTES=2097152
