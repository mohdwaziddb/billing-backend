SPRING_PROFILES_ACTIVE=prod
PORT=8080
# Never commit real credentials. Copy this file to .env and fill values locally.
# DB_URL example format only — replace host, port and database.
DB_URL=jdbc:mysql://CHANGE-ME-HOST:3306/CHANGE-ME-DB?useSSL=true&serverTimezone=UTC
DB_USERNAME=CHANGE-ME-USER
DB_PASSWORD=CHANGE-ME-PASSWORD
HIBERNATE_DDL_AUTO=validate
# Minimum 32 chars, generated via: openssl rand -base64 48
# MUST be different from APP_ENCRYPTION_SECRET.
JWT_SECRET=CHANGE-ME-JWT-SECRET-MIN-32-CHARS-GENERATE-NEW
# Minimum 32 chars, generated via: openssl rand -base64 48
# MUST be different from JWT_SECRET. Required in prod.
APP_ENCRYPTION_SECRET=CHANGE-ME-ENCRYPTION-SECRET-MIN-32-CHARS-GENERATE-NEW
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
FRONTEND_URL=https://CHANGE-ME.example.com/
CORS_ALLOWED_ORIGINS=https://CHANGE-ME.example.com/
REMINDER_MOCK_MODE=false
JPA_SHOW_SQL=false
